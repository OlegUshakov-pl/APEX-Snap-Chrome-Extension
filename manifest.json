{
  "manifest_version": 3,
  "name": "ApexShot",
  "version": "2.0",
  "description": "Search snapshots via the local FastAPI app. Thin client: sends your query to the local search backend and renders the results.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_title": "ApexShot - search",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
