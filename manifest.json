{
  "manifest_version": 3,
  "name": "Binary Snap - AI Indexer",
  "version": "1.0",
  "description": "Создает бинарные слепки страниц с AI и отправляет их на сервер за 5 PLN.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "icons/icon48.png",
    },
    "default_popup": "popup.html",
  },
  "icons": {
    "48": "assets/icon-48.svg",
    "128": "assets/icon-48.svg"
  }
}
