{
  "manifest_version": 3,
  "name": "Binary Snap - AI Indexer",
  "version": "1.0",
  "description": "Создает бинарные слепки страниц с AI и отправляет их на сервер за 5 PLN.",
  "permissions": ["activeTab", "scripting", "downloads", "tabs", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "assets/icon-16.svg",
      "48": "assets/icon-48.svg"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icon-16.svg",
    "48": "assets/icon-48.svg"
  }
}
