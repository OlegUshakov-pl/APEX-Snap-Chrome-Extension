{
  "manifest_version": 3,
  "name": "ApexScan",
  "version": "1.0",
  "description": "Creates binary snapshots of web pages with AI indexing and sends them to a server for 5 PLN.",
  "permissions": ["activeTab", "scripting", "downloads", "tabs", "storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png"
  }
}
